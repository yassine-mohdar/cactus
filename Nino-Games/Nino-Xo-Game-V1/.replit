modules = ["nodejs-24", "postgresql-16"]

[[artifacts]]
id = "artifacts/api-server"

[[artifacts]]
id = "artifacts/mockup-sandbox"

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "nino-xo-tests"

[[workflows.workflow]]
name = "nino-xo-tests"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd artifacts/nino-xo && pnpm test"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
EXPO_PUBLIC_FIREBASE_PROJECT_ID = "nino-xo"
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN = "nino-xo.firebaseapp.com"
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET = "nino-xo.firebasestorage.app"
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID = "5645500787"
EXPO_PUBLIC_FIREBASE_APP_ID = "1:5645500787:web:ba84bc8534cd3c0cdc0506"
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID = "G-0VB1S4T6T8"
ADMIN_EMAIL = "mohdar@fleure.ma"

[userenv.development]
