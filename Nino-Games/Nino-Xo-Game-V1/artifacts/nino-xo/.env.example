# =============================================================================
#  Nino XO — Expo App
#  Copy this file to .env and fill in real values.
#  On Replit, set these in Secrets (lock icon in the sidebar) instead.
# =============================================================================

# ── API Server ────────────────────────────────────────────────────────────────
# Full URL of the Nino XO API server (no trailing slash).
# On Replit this is the reverse-proxy URL of the api-server artifact.
EXPO_PUBLIC_API_URL=https://your-replit-domain/api-server

# ── RevenueCat (in-app subscriptions) ────────────────────────────────────────
# Get from RevenueCat dashboard → Project → API Keys
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
