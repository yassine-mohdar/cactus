# =============================================================================
#  Nino XO — API Server
#  Copy this file to .env and fill in real values.
#  On Replit, set these in Secrets (lock icon in the sidebar) instead.
# =============================================================================

# ── Database ──────────────────────────────────────────────────────────────────
# Auto-provided by Replit PostgreSQL. Copy from the Replit DB panel.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
# PORT is assigned automatically by Replit — do not set manually in production.
PORT=8080

# ── JWT ───────────────────────────────────────────────────────────────────────
# Sign player session tokens. Without this, all sessions reset on server restart.
# Generate with: openssl rand -base64 64
JWT_SECRET=replace_with_long_random_secret

# ── Match Tokens ──────────────────────────────────────────────────────────────
# Signs match result tokens to prevent tampering.
# Generate with: openssl rand -base64 32
MATCH_TOKEN_SECRET=replace_with_long_random_secret

# ── Admin ─────────────────────────────────────────────────────────────────────
# The player who signs in with this email automatically gets admin privileges.
# On first server boot, an admin account is seeded with this email.
# Current admin: admin@ninoxo.app (id: admin_1a6d5eceefe179a9)
ADMIN_EMAIL=admin@ninoxo.app

# ── Email — Gmail SMTP (option 1) ─────────────────────────────────────────────
# Go to Google Account → Security → 2-Step Verification → App Passwords
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=xxxx_xxxx_xxxx_xxxx

# ── Email — Resend (option 2, used if Gmail not configured) ───────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# ── Email — Sender address ────────────────────────────────────────────────────
# "From" address shown in all outgoing emails.
# Defaults to GMAIL_USER if Gmail is configured, otherwise noreply@ninoxo.app
OTP_FROM_EMAIL=noreply@ninoxo.app

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Google Cloud Console → APIs & Credentials → OAuth 2.0 Client IDs → Web client
GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# ── Apple OAuth ───────────────────────────────────────────────────────────────
# Apple Developer → Certificates, IDs & Profiles → Services IDs
APPLE_CLIENT_ID=com.nino.xo.app.signin

# ── Game ──────────────────────────────────────────────────────────────────────
# Tokens awarded to the winner of each match. Default: 50
WIN_REWARD_AMOUNT=50
